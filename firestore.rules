rules_version = '2';

// Règles Firestore de ListMe (pas d'authentification).
// Principe : une liste n'est accessible qu'à qui connaît son identifiant
// (20 caractères aléatoires). Il est impossible de lister toutes les listes.
service cloud.firestore {
  match /databases/{database}/documents {

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Catalogue partagé des produits ajoutés par les utilisateurs.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if productId.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'nameNorm', 'aisle', 'createdAt', 'updatedAt'])
        && shortString(request.resource.data.name, 60)
        && shortString(request.resource.data.aisle, 40);
      // Seuls les produits ajoutés par les utilisateurs existent ici : ils peuvent être retirés.
      allow delete: if true;
    }

    // Espace personnel : listes, magasins et favori partagés entre les appareils d'une personne.
    match /spaces/{spaceId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if spaceId.size() >= 16 && spaceId.size() <= 64
        && request.resource.data.keys().hasOnly(['lists', 'stores', 'favStore', 'updatedAt'])
        && (!('lists' in request.resource.data) || (request.resource.data.lists is map && request.resource.data.lists.size() <= 400))
        && (!('stores' in request.resource.data) || (request.resource.data.stores is map && request.resource.data.stores.size() <= 400))
        && (!('favStore' in request.resource.data) || request.resource.data.favStore == null || shortString(request.resource.data.favStore, 64));
      allow delete: if false;
    }

    // Magasins : nom, position GPS du magasin et prix unitaires par produit.
    // Accessibles uniquement à qui connaît leur identifiant (rattaché aux listes).
    match /stores/{storeId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if storeId.size() >= 16 && storeId.size() <= 64
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'prices', 'createdAt', 'updatedAt'])
        && shortString(request.resource.data.name, 60)
        && (request.resource.data.lat == null || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (request.resource.data.lng == null || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
        && request.resource.data.prices is map
        && request.resource.data.prices.size() <= 3000;
      allow delete: if true;
    }

    match /lists/{listId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if listId.size() >= 16 && listId.size() <= 64
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt', 'storeIds'])
        && (!('name' in request.resource.data) || shortString(request.resource.data.name, 60))
        && (!('storeIds' in request.resource.data)
            || (request.resource.data.storeIds is list && request.resource.data.storeIds.size() <= 30));
      allow delete: if false;

      match /items/{itemId} {
        allow read: if true;
        allow create, update: if itemId.size() <= 64
          && request.resource.data.keys().hasOnly(['name', 'nameNorm', 'aisle', 'qty', 'checked', 'checkedAt', 'createdAt', 'updatedAt'])
          && shortString(request.resource.data.name, 60)
          && shortString(request.resource.data.aisle, 40)
          && request.resource.data.checked is bool
          && (request.resource.data.qty is number || shortString(request.resource.data.qty, 20));
        allow delete: if true;
      }
    }
  }
}
